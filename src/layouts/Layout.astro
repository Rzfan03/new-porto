---
import "../styles/global.css"
import { Icon } from 'astro-icon/components'
import { ClientRouter } from 'astro:transitions'
import datas from "../config/config";
import axios from "axios"
import ScaleIn from '@astroanimate/core/ScaleIn';
import FadeInText from '@astroanimate/core/FadeInText';
import BlogCard  from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import SpotifyIsland  from "../components/SpotifyIsland.astro";

const posts = await getCollection('blog')

// fallback
let githubData;

try {
    const base_url = `https://api.github.com/users/${datas.Github}`
const res = await axios.get(base_url)
githubData = res.data
  
} catch(error) {
  githubData = 
     {
       followers: 36,
       following: 91,
       created_at: "2024-07-31T05:44:33Z"
     }
}

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>Rzfan03 | Software Enginee</title>
	</head>
	<body class="bg-zinc-900">
<main class="flex flex-col justify-center gap-6 p-3">
    <!-- home section -->
   	<section id="home" class="md:h-[68vh] max-md:h-[57vh] flex justify-center items-center flex-col">
        <div class="max-md:h-screen relative">
       <!-- banner -->
          <img class="max-sm:max-w-120 w-4xl rounded-lg border-2 border-white h-70 object-cover" src={datas.Banner}/>
          <div class="flex gap-3 items-center absolute top-57 left-6">
          <!-- Avatar -->
      <ScaleIn enhance={true}>
          <img src={datas.Avatar} class="rounded-full max-md:w-30 max-md:h-30 border-3 h-41 saturate-0 hover:saturate-100 transition w-41 border-white"/>
      </ScaleIn>
      <div class="flex flex-col gap-1 mt-18 ml-2">
          <div class="flex gap-3 items-center">
              <p class="text-white font-bold text-2xl">{`${datas.Github}`}</p>
              <Icon class={'text-white bg-zinc-700 border border-zinc-800 w-6 h-6 rounded-full inset-shadow-2xs inset-shadow-zinc-500'} name="mdi:check"/>
          </div>
          <p class="text-zinc-500">{`@${datas.Nickname}`}</p>
          <p class="text-zinc-300 mb-5">{datas.Bio}</p>
          <div class="flex gap-3 items-center">
              <div class="flex gap-4 items-center max-md:hidden">
                  <p class="text-white text-lg">{githubData.followers} Followers</p>
                  <p class="text-white text-lg">{githubData.following} Following</p>
                   <p class="text-white text-lg">Joined at {githubData.created_at.slice(0, 4)}</p>
              </div>
          </div>
   </div>
       </div>
       
       <div class="relative top-36 border-b border-zinc-800 h-8 p-2 w-4xl max-md:max-w-120">
       </div>
       <!-- separator -->
   </div>
   </section>
   
   <!-- about section -->
   <section id="about-me">
       <FadeInText class="flex flex-col gap-2 text-white" enhance={true}>
           <p class="text-white font-bold text-2xl underline">[Who am i?]</p>
          <div class="mt-3">
               <p>Let me introduce my self.</p>
               <p class="text-md max-w-4xl">Hi! I'm Rizqy Fajrul Syabani, a 17-year-old Software Engineer and dedicated Linux enthusiast with a deep passion for continuous learning and building efficient systems.</p>
               <br/>
               <p class="text-md max-w-4xl">Driven by strong technical curiosity, I thrive on exploring emerging technologies, mastering new programming languages, and experimenting with modern frameworks. For me, software engineering is more than just writing code—it is about solving complex problems, writing clean and maintainable architecture, and turning ideas into impactful digital products.</p>
               <br/>
               <p class="text-md max-w-4xl max-md:hidden">Driven by strong technical curiosity, I thrive on exploring emerging technologies, mastering new programming languages, and experimenting with modern frameworks. For me, software engineering is more than just writing code—it is about solving complex problems, writing clean and maintainable architecture, and turning ideas into impactful digital products.</p>
               <br/>
               <p class="text-md max-w-4xl max-md:hidden">As a Linux enthusiast, I rely on Linux as my primary daily driver. I deeply align with the open-source philosophy, valuing the complete freedom it provides to control, tweak, and optimize my operating system. Tailoring my environment down to the smallest detail not only sharpens my understanding of system internals but also creates an intuitive, high-performance workflow for my daily development work.</p>
               
          </div>
       </FadeInText>
   </section>

   <!-- setup section -->
   <section id="my-setup">
         <FadeInText class="text-white font-bold text-2xl underline mb-4" as="p" enhance={true}>[My Setup]</FadeInText>
       <FadeInText enhance={true}>
       <div class="relative group">
            <img loading="lazy" class="w-4xl h-fit object-cover " src={'./setup.jpg'} />
            <div class="absolute max-md:hidden group-hover:bg-black/60 bg-transparent bottom-0 cursor-pointer w-4xl h-20 z-20 transition-all">
                <a href="https://github.com/Rzfan03/Kanso" class="absolute bottom-7 left-4 text-transparent group-hover:text-white underline">https://github.com/Rzfan03/Kanso</a>
            </div>
       </div>
       </FadeInText>

       <FadeInText class="flex flex-col gap-2 mt-3 text-white" enhance={true}>
           <p>Distro : <a href="https://cachyos.org/" class="underline">CachyOS</a></p>
           <p>Terminal : <a href="https://alacritty.org/" class="underline">Alacritty</a></p>
           <p>WM : <a href="https://i3wm.org/" class="underline">i3Wm</a></p>
           <p>Editor : <a href="https://zed.dev/" class="underline">Zed</a></p>
       </FadeInText>
   </section>

   <!-- projectt section -->
   <section id="projects" class="mt-4 h-[35vh]">
        <FadeInText class="text-white font-bold text-2xl underline mb-4" as="p" enhance={true}>[My Projects!?]</FadeInText>
        <FadeInText as="a" href="https://github.com/Rzfan03?tab=repositories" class="text-white" enhance={true}>check in my github broo, click this text. aku nak tido</FadeInText>
        <FadeInText enhance={true}><img class="p-2 w-56 mt-2 h-56" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIbtz082HpAYl3nU0IlmIo1dpy97zCjMeyxDUQNPzb0PmsW060vf3aIKQ&s=10"/></FadeInText>
   </section>

   <!-- blog section -->
   <section id="blog" class="mt-4">
        <FadeInText class="text-white font-bold text-2xl underline mb-4" as="p" enhance={true}>[My Blog]</FadeInText>
         {posts.map((post, i) => <ScaleIn enhance={true} delay={i * 100}><BlogCard posts={post} /></ScaleIn>)}
   </section>
   
</main>
<SpotifyIsland />
	</body>
</html>
